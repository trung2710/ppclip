PORT=3005

# n8n base URL, without trailing slash.
N8N_BASE_URL=https://your-ngrok-domain.ngrok-free.dev

# n8n API key from Settings -> n8n API.
N8N_API_KEY=replace-with-your-n8n-api-key

# Webhook B: the n8n workflow called by the Paperclip HTTP agent.
N8N_WEBHOOK_URL=https://your-ngrok-domain.ngrok-free.dev/webhook/replace-with-webhook-id

# Workflow id of Webhook B, from /workflow/<workflowId>/executions/<executionId>.
N8N_WORKFLOW_ID=replace-with-workflow-id

# Polling behavior.
POLL_INTERVAL_MS=1000
FIND_EXECUTION_TIMEOUT_MS=30000
EXECUTION_TIMEOUT_MS=300000

# If true, bridge confirms the n8n execution contains traceId in Webhook input.
MATCH_TRACE_ID=true

# Set true only for local debugging. It may expose sensitive prompt/input data.
INCLUDE_INPUT_SUMMARY=false

# Log detail:
# compact = short human-readable node logs.
# verbose = includes outputSummary for deeper debugging.
LOG_DETAIL=compact
