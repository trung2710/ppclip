        "jsCode": "const hrKeywords = [\n  'tuyển dụng', 'nhân sự', 'ứng viên', 'phỏng vấn', 'lương', \n  'thử việc', 'hợp đồng', 'kpi', 'đào tạo', 'nghỉ phép', 'chấm công'\n];\n\nconst accountingKeywords = [\n  'kế toán', 'báo cáo', 'doanh thu', 'chi phí', 'hóa đơn', \n  'thuế', 'sổ sách', 'ngân sách', 'dòng tiền', 'thanh toán', 'công nợ'\n];\n\nfor (const item of $input.all()) {\n  // Lấy chính xác title từ node \"Tạo task phân tích câu hỏi\"\n  const rawTitle = $('CEO').first().json.body.context.paperclipWake.issue.title || '';\n  const title = String(rawTitle).toLowerCase();\n\n  const hrScore = hrKeywords.reduce((count, kw) => count + (title.includes(kw) ? 1 : 0), 0);\n  const accScore = accountingKeywords.reduce((count, kw) => count + (title.includes(kw) ? 1 : 0), 0);\n\n  if (hrScore > accScore) {\n    item.json.department = 'HR';\n  } else if (accScore > hrScore) {\n    item.json.department = 'Kế toán';\n  } else {\n    item.json.department = 'Khác';\n  }\n}\n\nreturn $input.all();"
      },
